{% extends 'base.html' %}
{% block webpageContent %}
{% load static %}

<!-- Page Content -->
<div class="container" style="max-width: 100%;">
    <!-- Header -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h4 class="card-title">Farm Map <span class="text-muted fw-normal ms-2"></span></h4>
        </div>
    </div>

    <!-- Date Selection -->
    <div class="row mb-3">
        <div class="col-md-3">
            <label>Start Date:</label>
            <input type="date" id="start-date" class="form-control" value="2024-11-23">
        </div>
        <div class="col-md-3">
            <label>End Date:</label>
            <input type="date" id="end-date" class="form-control" value="2024-12-23">
        </div>
    </div>

    <!-- Map Section -->
    <div class="row">
        <div class="col-12">
            <div id="map" style="height: 500px; border: 1px solid #ccc; border-radius: 8px;"></div>
        </div>
    </div>
    <div class="mt-3">
        <button id="start-draw" class="btn btn-primary">Start Drawing</button>
        <button id="end-draw" class="btn btn-secondary">Cancel Drawing</button>
        <button class="btn btn-success" onclick="submitPolygon()">Get NDVI</button>
        <button id="save-ndvi-btn" class="btn btn-success">💾 Save NDVI Region</button>
        <button id="generate-report-btn" class="btn btn-info">📄 Generate Report</button>
    </div>
    <div class="mb-3">
      <label for="draw-shape">Select Shape:</label>
      <select id="draw-shape" class="form-select" style="width: 200px;">
          <option value="polygon" selected>Polygon</option>
          <option value="rectangle">Rectangle</option>
          <option value="custom">Custom</option>
      </select>

    </div>


    <!-- NDVI Image Display -->
    <div class="row mt-4">
        <div class="col-12">
            <h5>NDVI Image</h5>
            <img id="ndvi-image" style="max-width: 100%; border: 1px solid #ccc;" />
        </div>
    </div>
</div>

<!-- Leaflet JS & CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.js"></script>

<script>
  let drawnPolygon = null;
  let drawHandler;
  const map = L.map('map').setView([-33.8688, 151.2093], 10);

  const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
  }).addTo(map);

  let sentinelLayer = L.tileLayer.wms('https://services.sentinel-hub.com/ogc/wms/{{ sentinel_instance_id }}', {
    layers: 'VEGETATION_INDEX',  // Use 'FALSE_COLOR', 'NDVI' etc. for other options
    format: 'image/png',
    transparent: true,
    SHOWLOGO: false,
    attribution: '&copy; Sentinel Hub',
  });

  // Layer Control
  const baseMaps = {
    "OpenStreetMap": osmLayer
  };

  const overlayMaps = {
    "Sentinel-2 Imagery": sentinelLayer
  };

  L.control.layers(baseMaps, overlayMaps).addTo(map);

  const drawnItems = new L.FeatureGroup();
  map.addLayer(drawnItems);

  drawHandler = new L.Draw.Polygon(map, {
    allowIntersection: false,
    showArea: true,
    drawError: {
      color: '#e1e100',
      message: '<strong>Error:</strong> shape invalid!'
    },
    shapeOptions: {
      color: '#97009c'
    }
  });

  // document.getElementById("start-draw").addEventListener("click", function() {
  //   drawHandler.enable();
  // });

  // document.getElementById("end-draw").addEventListener("click", function() {
  //   drawHandler.disable();
  // });

  map.on(L.Draw.Event.CREATED, function (event) {
    if (drawnPolygon) map.removeLayer(drawnPolygon);
    drawnPolygon = event.layer;
    drawnItems.addLayer(drawnPolygon);
  });

  function submitPolygon() {
    if (!drawnPolygon) {
      alert("Please draw a region first.");
      return;
    }
    const geojson = drawnPolygon.toGeoJSON();
    const startDate = document.getElementById("start-date").value;
    const endDate = document.getElementById("end-date").value;
    fetch("/map/api/ndvi/", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRFToken": "{{ csrf_token }}"
      },
      body: JSON.stringify({
        geometry: geojson.geometry,
        start_date: startDate,
        end_date: endDate
      })
    })
    .then(res => {
      if (!res.ok) throw new Error("Network response was not ok");
      return res.blob();
    })
    .then(blob => {
      const imageUrl = URL.createObjectURL(blob);
      document.getElementById("ndvi-image").src = imageUrl;
    })
    .catch(err => {
      alert("Error fetching NDVI image");
      console.error(err);
    });
  }
  document.getElementById("save-ndvi-btn").addEventListener("click", function () {
    if (!drawnPolygon) {
        alert("Please draw a region first.");
        return;
    }

    const geojson = drawnPolygon.toGeoJSON();
    const startDate = document.getElementById("start-date").value;
    const endDate = document.getElementById("end-date").value;

    fetch("/map/api/save-ndvi/", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "X-CSRFToken": "{{ csrf_token }}"
        },
        body: JSON.stringify({
            geometry: geojson.geometry,
            start_date: startDate,
            end_date: endDate
        })
    })
    .then(res => {
        if (!res.ok) throw new Error("Network response was not ok");
        return res.json();
    })
    .then(data => {
        if (data.status === "ok") {
            alert("NDVI region saved successfully! Region ID: " + data.id);
        } else {
            alert("Failed to save NDVI region.");
        }
    })
    .catch(err => {
        alert("Error saving NDVI region.");
        console.error(err);
    });
  });

  document.getElementById("generate-report-btn").addEventListener("click", function () {
    if (!drawnPolygon) {
        alert("Please draw a region first.");
        return;
    }

    const geojson = drawnPolygon.toGeoJSON();
    const startDate = document.getElementById("start-date").value;
    const endDate = document.getElementById("end-date").value;

    fetch("/map/api/generate-report/", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "X-CSRFToken": "{{ csrf_token }}"
        },
        body: JSON.stringify({
            geometry: geojson.geometry,
            start_date: startDate,
            end_date: endDate
        })
    })
    .then(res => {
        if (!res.ok) throw new Error("Network response was not ok");
        return res.blob(); // Assuming the report is returned as a file (e.g., PDF)
    })
    .then(blob => {
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.style.display = "none";
        a.href = url;
        a.download = "NDVI_Report.pdf"; // Default file name
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        alert("Report downloaded successfully!");
    })
    .catch(err => {
        alert("Error generating report.");
        console.error(err);
    });
  });


// let drawnFixedPolygon = null; // 
// const drawnItems = new L.FeatureGroup();
// let drawnPolygon = null;


const customDrawer = new L.Draw.Polygon(map, {
  allowIntersection: false,
  showArea: true,
  drawError: {
    color: '#e1e100',
    message: '<strong>Error:</strong> shape invalid!'
  },
  shapeOptions: {
    color: '#97009c',
    weight: 2,
    fillOpacity: 0.1
  }
});

const polygonDrawer = new L.Draw.Polygon(map, {
  allowIntersection: false,
  showArea: true,
  shapeOptions: { color: '#97009c', fillOpacity: 0.1 }
});

const rectangleDrawer = new L.Draw.Rectangle(map, {
  shapeOptions: { color: '#ff7800', fillOpacity: 0.1 }
});

const circleDrawer = new L.Draw.Circle(map, {
  shapeOptions: { color: '#007bff', fillOpacity: 0.1 }
});

function disableAllDrawers() {
  polygonDrawer.disable();
  rectangleDrawer.disable();
  customDrawer.disable();
}


document.getElementById("start-draw").addEventListener("click", function () {
  const shape = document.getElementById("draw-shape").value;
  disableAllDrawers();

  if (shape === "polygon") polygonDrawer.enable();
  else if (shape === "rectangle") rectangleDrawer.enable();
  else if (shape === "custom") customDrawer.enable();
});

document.getElementById("end-draw").addEventListener("click", function () {
  disableAllDrawers();
});

map.on(L.Draw.Event.CREATED, function (event) {
  if (drawnPolygon) {
    map.removeLayer(drawnPolygon);
  }

  drawnPolygon = event.layer;

  drawnPolygon.setStyle({
    fillColor: "#ffffff",
    fillOpacity: 0.1,
    color: "#ff0000",
    weight: 2
  });

  drawnPolygon.addTo(map);
});




</script>

{% endblock %}